\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Equilibrium coalescence and the double-zero degeneracy. (a) The positive equilibrium branches $E_-$ and $E_+$ merge at $(r_{\mathrm  {SN}},q_{\mathrm  {SN}})$, marked by a black diamond. The lower branch consists of saddles, whereas the upper branch consists of nonsaddle equilibria. (b) Spectrum at the coalesced equilibrium along $r=r_{\mathrm  {SN}}$. One eigenvalue remains zero, while the transverse eigenvalue $\lambda _\perp =(1+2q_{\mathrm  {SN}}) (\varepsilon _{\mathrm  {BT}}-\varepsilon )$ changes sign at $\varepsilon =\varepsilon _{\mathrm  {BT}}$. Lines represent the analytical expressions, and open circles show eigenvalues computed from the original Jacobian. (c) The saddle-node curve (black) and the Hopf curve (purple) meet at the Bogdanov--Takens point. Blue and orange shading indicate, respectively, asymptotic stability and instability of $E_+$; the gray region contains no positive equilibrium. The laminar equilibrium remains asymptotically stable throughout. The circles on the saddle-node curve identify the parameters used in panels\nonbreakingspace (a) and\nonbreakingspace (c) of Fig.\nonbreakingspace \ref {fig:barkley-fold-portraits}. Here $r_{\mathrm  {SN}}\simeq 0.645189834506$, $q_{\mathrm  {SN}}\simeq 0.802140181960$, and $\varepsilon _{\mathrm  {BT}}\simeq 0.090827436864$. }}{7}{figure.1}\protected@file@percent }
\newlabel{fig:barkley-fold-diagnostics}{{1}{7}{Equilibrium coalescence and the double-zero degeneracy. (a) The positive equilibrium branches $E_-$ and $E_+$ merge at $(r_{\mathrm {SN}},q_{\mathrm {SN}})$, marked by a black diamond. The lower branch consists of saddles, whereas the upper branch consists of nonsaddle equilibria. (b) Spectrum at the coalesced equilibrium along $r=r_{\mathrm {SN}}$. One eigenvalue remains zero, while the transverse eigenvalue $\lambda _\perp =(1+2q_{\mathrm {SN}}) (\varepsilon _{\mathrm {BT}}-\varepsilon )$ changes sign at $\varepsilon =\varepsilon _{\mathrm {BT}}$. Lines represent the analytical expressions, and open circles show eigenvalues computed from the original Jacobian. (c) The saddle-node curve (black) and the Hopf curve (purple) meet at the Bogdanov--Takens point. Blue and orange shading indicate, respectively, asymptotic stability and instability of $E_+$; the gray region contains no positive equilibrium. The laminar equilibrium remains asymptotically stable throughout. The circles on the saddle-node curve identify the parameters used in panels~(a) and~(c) of Fig.~\ref {fig:barkley-fold-portraits}. Here $r_{\mathrm {SN}}\simeq 0.645189834506$, $q_{\mathrm {SN}}\simeq 0.802140181960$, and $\varepsilon _{\mathrm {BT}}\simeq 0.090827436864$}{figure.1}{}}
\newlabel{subsec:bl-Hopf}{{5.4}{7}{The Hopf curve and the emerging limit cycle}{subsection.5.4}{}}
\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{5.4}{The Hopf curve and the emerging limit cycle}}{7}{subsection.5.4}\protected@file@percent }
\newlabel{eq:bl-Hopf-frequency}{{21}{7}{The Hopf curve and the emerging limit cycle}{equation.5.21}{}}
\newlabel{eq:bl-Hopf-transversality}{{22}{7}{The Hopf curve and the emerging limit cycle}{equation.5.22}{}}
\citation{kuznetsov2006andronov}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Local flow at the equilibrium coalescence $r=r_{\mathrm  {SN}}$, represented in the coordinates $(q-q_{\mathrm  {SN}},v)$ with $v=\dot  q$. The black diamond marks the coalesced equilibrium. (a) For $\varepsilon =\varepsilon _{\mathrm  {BT}}-0.025$, the transverse eigenvalue is positive, and the orange curves highlight the strong unstable manifold of the saddle-node. (b) At $\varepsilon =\varepsilon _{\mathrm  {BT}}$, both eigenvalues vanish. The incoming blue branch and outgoing orange branch form the cusp separatrices of the nondegenerate Bogdanov--Takens equilibrium. (c) For $\varepsilon =\varepsilon _{\mathrm  {BT}}+0.025$, the transverse eigenvalue is negative, and the blue curves highlight the strong stable manifold of the saddle-node. Gray streamlines represent nearby trajectories, and arrows indicate the forward-time orientation. Identical axis limits are used in all panels to make the change in local geometry directly comparable. }}{8}{figure.2}\protected@file@percent }
\newlabel{fig:barkley-fold-portraits}{{2}{8}{Local flow at the equilibrium coalescence $r=r_{\mathrm {SN}}$, represented in the coordinates $(q-q_{\mathrm {SN}},v)$ with $v=\dot q$. The black diamond marks the coalesced equilibrium. (a) For $\varepsilon =\varepsilon _{\mathrm {BT}}-0.025$, the transverse eigenvalue is positive, and the orange curves highlight the strong unstable manifold of the saddle-node. (b) At $\varepsilon =\varepsilon _{\mathrm {BT}}$, both eigenvalues vanish. The incoming blue branch and outgoing orange branch form the cusp separatrices of the nondegenerate Bogdanov--Takens equilibrium. (c) For $\varepsilon =\varepsilon _{\mathrm {BT}}+0.025$, the transverse eigenvalue is negative, and the blue curves highlight the strong stable manifold of the saddle-node. Gray streamlines represent nearby trajectories, and arrows indicate the forward-time orientation. Identical axis limits are used in all panels to make the change in local geometry directly comparable}{figure.2}{}}
