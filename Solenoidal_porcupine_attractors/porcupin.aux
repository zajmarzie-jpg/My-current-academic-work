\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  Numerical illustration of \emph  {statistical synchronization} in the porcupine regime. Although the maximal attractor has a highly nontrivial porcupine geometry and lacks pointwise synchronization, empirical distributions of typical fiber orbits converge to a unique fiberwise SRB-like probability measure. The figure shows the collapse of empirical measures under random fiber iterations, illustrating convergence in distribution rather than convergence of individual trajectories. This behavior exemplifies synchronization at the statistical level, as established in Definition \ref {stisynch} and Corollary \ref {cor:unique_ergodic}. }}{41}{figure.4}\protected@file@percent }
\newlabel{fig:sync}{{4}{41}{Numerical illustration of \emph {statistical synchronization} in the porcupine regime. Although the maximal attractor has a highly nontrivial porcupine geometry and lacks pointwise synchronization, empirical distributions of typical fiber orbits converge to a unique fiberwise SRB-like probability measure. The figure shows the collapse of empirical measures under random fiber iterations, illustrating convergence in distribution rather than convergence of individual trajectories. This behavior exemplifies synchronization at the statistical level, as established in Definition \ref {stisynch} and Corollary \ref {cor:unique_ergodic}}{figure.4}{}}
\newlabel{cor:unique_ergodic}{{6.4}{41}{Statistical synchronization and ergodicity}{theorem.6.4}{}}
\newlabel{ass:base_ergodic_mixing}{{i}{41}{Statistical synchronization and ergodicity}{Item.15}{}}
\newlabel{ass:unique_stationary}{{ii}{41}{Statistical synchronization and ergodicity}{Item.16}{}}
\newlabel{ass:ergodic_coupling}{{iii}{42}{Statistical synchronization and ergodicity}{Item.17}{}}
\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{6.3}{Numerical illustration of uniqueness and convergence}}{43}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Numerical illustration of convergence and uniqueness for the random contractive dynamical system. \textbf  {Top row:} empirical densities on a $120\times 120$ grid at iterations $n=0,4,19,99,219$, showing contraction of the initial uniform distribution toward the invariant attracting set. \textbf  {Middle panel:} total-variation distance $\|\rho _n-\rho _\infty \|_{\mathrm  {TV}}$ (log scale) between empirical and limiting densities, exhibiting exponential decay that confirms a spectral gap and uniqueness of the stationary measure. \textbf  {Bottom panel:} fraction of total mass inside the inner contracting ball $B_{r^*}$ ($r^*=0.05$) versus iteration, rapidly approaching\nonbreakingspace 1. Simulations used map-selection probabilities $(0.20,0.27,0.27,0.26)$ with $3\times 10^4$ particles and random seed\nonbreakingspace \texttt  {42}, supporting Corollary\nonbreakingspace \ref {cor:unique_ergodic}. }}{44}{figure.5}\protected@file@percent }
\newlabel{picc1}{{5}{44}{Numerical illustration of convergence and uniqueness for the random contractive dynamical system. \textbf {Top row:} empirical densities on a $120\times 120$ grid at iterations $n=0,4,19,99,219$, showing contraction of the initial uniform distribution toward the invariant attracting set. \textbf {Middle panel:} total-variation distance $\|\rho _n-\rho _\infty \|_{\mathrm {TV}}$ (log scale) between empirical and limiting densities, exhibiting exponential decay that confirms a spectral gap and uniqueness of the stationary measure. \textbf {Bottom panel:} fraction of total mass inside the inner contracting ball $B_{r^*}$ ($r^*=0.05$) versus iteration, rapidly approaching~1. Simulations used map-selection probabilities $(0.20,0.27,0.27,0.26)$ with $3\times 10^4$ particles and random seed~\texttt {42}, supporting Corollary~\ref {cor:unique_ergodic}}{figure.5}{}}
