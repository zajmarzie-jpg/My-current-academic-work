\@writefile{toc}{\contentsline {section}{\tocsection {}{1}{Active oscillator--actuator model}}{1}{section.1}\protected@file@percent }
\newlabel{eq:model}{{1}{1}{Active oscillator--actuator model}{equation.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Numerical verification of the periodic orbit bifurcating from the zero--Hopf equilibrium for $\omega _0=2$, $\tau =1$, $\kappa =1$, $d=0.2$, $g_1=-0.2$, $k_1=1$, and $\varepsilon =0.02$. Panel\nonbreakingspace (a) compares the periodic orbit obtained by numerical integration of the full oscillator--actuator system with its first-order approximation derived by averaging. Panel\nonbreakingspace (b) shows successive intersections of the numerical trajectory with the Poincaré section $v=0$, $\dot  v<0$. The convergence of these intersections toward a single point provides numerical evidence for the orbital asymptotic stability predicted by $\varepsilon g_1<0$.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:numerical-verification}{{1}{3}{Numerical verification of the periodic orbit bifurcating from the zero--Hopf equilibrium for $\omega _0=2$, $\tau =1$, $\kappa =1$, $d=0.2$, $g_1=-0.2$, $k_1=1$, and $\varepsilon =0.02$. Panel~(a) compares the periodic orbit obtained by numerical integration of the full oscillator--actuator system with its first-order approximation derived by averaging. Panel~(b) shows successive intersections of the numerical trajectory with the Poincaré section $v=0$, $\dot v<0$. The convergence of these intersections toward a single point provides numerical evidence for the orbital asymptotic stability predicted by $\varepsilon g_1<0$}{figure.1}{}}
