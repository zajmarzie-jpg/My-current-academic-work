\newlabel{sec:discussion}{{5}{26}{Discussion and conclusions}{section.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Growth of the attracting invariant-curve amplitude on the canonical Poincar\'e section for \(\epsilon =10^{-2}\). The ordinate is \(A_\Sigma ^2\), defined by \eqref  {eq:section-amplitude}. The solid line is a linear fit to the four parameter values closest to the bifurcation. The vertical dashed line marks the independently computed Floquet crossing \(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \sigma $}\mathaccent "0362{\sigma }_c=2.758704047\ldots  \), while the dotted line marks the critical value extrapolated from the amplitude fit. Their close agreement and the near-linearity of \(A_\Sigma ^2\) are consistent with the expected square-root torus-amplitude law.}}{27}{figure.3}\protected@file@percent }
\newlabel{fig:torus-amplitude-scaling}{{3}{27}{Growth of the attracting invariant-curve amplitude on the canonical Poincar\'e section for \(\epsilon =10^{-2}\). The ordinate is \(A_\Sigma ^2\), defined by \eqref {eq:section-amplitude}. The solid line is a linear fit to the four parameter values closest to the bifurcation. The vertical dashed line marks the independently computed Floquet crossing \(\widehat {\sigma }_c=2.758704047\ldots \), while the dotted line marks the critical value extrapolated from the amplitude fit. Their close agreement and the near-linearity of \(A_\Sigma ^2\) are consistent with the expected square-root torus-amplitude law}{figure.3}{}}
