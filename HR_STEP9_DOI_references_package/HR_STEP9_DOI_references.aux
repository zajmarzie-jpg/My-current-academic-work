\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Convergence of the full-system Floquet crossing to the asymptotic critical curve in Example\nonbreakingspace \ref {ex:parameters}. The final column should converge to \(\sigma _{1,1}=76/9=8.44444\ldots  \) as \(\epsilon \to 0^+\).}}{23}{table.1}\protected@file@percent }
\newlabel{tab:sigma-convergence}{{1}{23}{Convergence of the full-system Floquet crossing to the asymptotic critical curve in Example~\ref {ex:parameters}. The final column should converge to \(\sigma _{1,1}=76/9=8.44444\ldots \) as \(\epsilon \to 0^+\)}{table.1}{}}
\newlabel{subsec:torus-validation}{{4.2}{23}{Numerical signature of the bifurcating invariant torus}{subsection.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{4.2}{Numerical signature of the bifurcating invariant torus}}{23}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Full-system Floquet validation for Example\nonbreakingspace \ref {ex:parameters} at \(\epsilon =10^{-2}\). The modulus of the nontrivial conjugate multiplier pair crosses the unit circle at \(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \sigma $}\mathaccent "0362{\sigma }_c=2.758704047\ldots  \). The vertical reference lines show the leading prediction \(\sigma _1^*=8/3\), the first corrected asymptotic prediction \(\sigma _1^*+(76/9)\epsilon =2.751111\ldots  \), and the numerical crossing. Throughout the scan the pair remains nonreal; the minimum absolute imaginary part is \(0.3357\).}}{24}{figure.1}\protected@file@percent }
\newlabel{fig:floquet-validation}{{1}{24}{Full-system Floquet validation for Example~\ref {ex:parameters} at \(\epsilon =10^{-2}\). The modulus of the nontrivial conjugate multiplier pair crosses the unit circle at \(\widehat {\sigma }_c=2.758704047\ldots \). The vertical reference lines show the leading prediction \(\sigma _1^*=8/3\), the first corrected asymptotic prediction \(\sigma _1^*+(76/9)\epsilon =2.751111\ldots \), and the numerical crossing. Throughout the scan the pair remains nonreal; the minimum absolute imaginary part is \(0.3357\)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Canonical Poincar\'e-section signature of the bifurcating invariant torus for Example\nonbreakingspace \ref {ex:parameters} with \(\epsilon =10^{-2}\) and \(\sigma _1=2.80\). The section is \(\Sigma =\{Y=0,\ X>0\}\), and the plotted coordinates are \((\rho ,\zeta )=(X/\epsilon ,Z/\epsilon )\). The section iterates form a smooth closed curve around the fixed point (cross) corresponding to the now-unstable periodic orbit. The 1938 plotted crossings were obtained from the high-accuracy DOP853 validation run after the attracting set had been reached.}}{25}{figure.2}\protected@file@percent }
\newlabel{fig:torus-section}{{2}{25}{Canonical Poincar\'e-section signature of the bifurcating invariant torus for Example~\ref {ex:parameters} with \(\epsilon =10^{-2}\) and \(\sigma _1=2.80\). The section is \(\Sigma =\{Y=0,\ X>0\}\), and the plotted coordinates are \((\rho ,\zeta )=(X/\epsilon ,Z/\epsilon )\). The section iterates form a smooth closed curve around the fixed point (cross) corresponding to the now-unstable periodic orbit. The 1938 plotted crossings were obtained from the high-accuracy DOP853 validation run after the attracting set had been reached}{figure.2}{}}
